#!/bin/sh
# Find each radio's Digirig sound card and write ALSA pcm.<radio> definitions.
# A Digirig is a USB hub with a CP2102N (uslcom) and a CM108 (uaudio -> pcm) on it,
# so the CP2102N serial number identifies the pcm unit that shares its hub.
conf=${DIGIRIG_CONF:-/usr/local/etc/digirig.conf}
dir=/var/run/digirig
out=$dir/asound.conf

parent() { sysctl -n "dev.$1.%parent" 2>/dev/null; }
units() { sysctl -N "dev.$1" 2>/dev/null | sed -n "s/^dev\.$1\.\([0-9]*\)\.%parent\$/\1/p"; }

install -d -m 755 $dir
tmp=$(mktemp $dir/asound.XXXXXX) || exit 1
echo "# generated by digirig-link from $conf; do not edit" > $tmp
grep -v "^#" $conf | while read radio serial rest; do
	[ -n "$radio" ] || continue
	hub=
	for u in $(units uslcom); do
		case "$(sysctl -n dev.uslcom.$u.%pnpinfo)" in
		*sernum=\"$serial\"*) hub=$(parent uslcom.$u) ;;
		esac
	done
	dsp=
	if [ -n "$hub" ]; then
		for a in $(units uaudio); do
			[ "$(parent uaudio.$a)" = "$hub" ] || continue
			for p in $(units pcm); do
				[ "$(parent pcm.$p)" = "uaudio$a" ] && dsp=/dev/dsp$p
			done
		done
	fi
	if [ -n "$dsp" ]; then
		printf "pcm.%s { type plug slave.pcm { type oss device \"%s\" } }\n" $radio $dsp >> $tmp
		logger -t digirig-link "$radio -> $dsp"
	else
		echo "# $radio: Digirig $serial not connected" >> $tmp
	fi
done
chmod 644 $tmp && mv $tmp $out
